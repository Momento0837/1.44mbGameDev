          },
          "dialogueTree": {
            "id": "normal_dialogue_03",
            "I_entry": ["김밥 한줄이요.", "기본 김밥 하나요!"],
            "II_additional": ["우엉이랑 단무지만 든 거 맞죠?", "매일 출근하면서 먹는데 질리지도 않네요."],
            "III_hoverHints": [
              {
                "materialId": "seaweed_and_rice",
                "nearby": [ "김은 누가 먼저 말려먹기 시작했을까요?", "밥이랑만 먹어도 맛있죠." ],
                "exact": ["김밥의 기본!"]
              },
              {
                "materialId": "burdock",
                "nearby": [ "오독오독 맛있어요.", "우엉 영어발음이 불독이랑 비슷한 거 아세요?" ],
                "exact": ["짭짤하게 무쳐두셨네요."]
              },
              {
                "materialId": "pickled_radish",
                "nearby": [ "옛날에 단무지만 주워 먹다가 된통 혼난 적 있어요.", "이게 빠지면 김밥이라고 하기 섭하달까." ],
                "exact": ["왜 단무지일까요? 새콤달콤하잖아요. 어쨌든 달아서 그런 건가?"]
              }
            ],
            "IV_afterCooking": ["김밥은 간단하게 먹기 참 좋죠. 잘 먹을게요!", "전 세상에서 우엉이 제일 좋아요."],
            "IV_afterCooking70Percent": ["기본 김밥 맞죠? 비율이 이상한데.", "이상해 보이긴 하지만 맛있겠죠 뭐. 설마 맛없겠어요?"],
            "IV_afterCooking50Percent": ["김밥 맞죠? 평소에 먹던 거랑 많이 다르게 생겼네요.", "이게 뭔가요?"],
            "V_emptySubmission": [ "이렇게 장사하지 마세요.", "이렇게 하면 돈이 되세요?" ]
