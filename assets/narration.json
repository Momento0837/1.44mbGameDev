      "menus": [
        {
          "id": "normal_menu_01",
          "name": "default_wrap",
          "recipe": {
            "ingredients": [
              {"materialId": "tortilla", "quantity": 1},
              {"materialId": "lettuce", "quantity": 2},
              {"materialId": "raw_carrot", "quantity": 1}
            ]
          },
          "dialogueTree": {
            "id": "normal_dialogue_01",
            "I_entry": ["안녕하세요. 기본 샐러드랩 하나 주세요.", "기본 랩 하나 주세요."],
            "II_additional": ["솔직히 기본이 가장 맛있는 거 아니겠어요?", "여기가 제일 맛있어요."],
            "III_hoverHints": [
              {
                "materialId": "lettuce",
                "nearby": [ "이상하게 양상추랑 양배추랑 헷갈려요.", "야채는 매일 아침마다 손질하시는 거에요?", "엄청 신선해보이네요!" ],
                "exact": ["맛있겠다. 얼른 만들어주세요!"]},
              {
                "materialId": "raw_carrot",
                "nearby": [ "당근이 눈에 좋다면서요?", "당근 싫어하는 사람 이해가 잘 안돼요." ], 
                "exact": ["맛있겠어요."]},
              {
                "materialId": "tortilla",
                "nearby": [ "또띠아 진짜 맛있지 않아요? 정신 없이 먹다가 살이 5kg나 쪘어요.", "베이직하니 가볍게 먹기 참 좋죠." ],
                "exact": [ "랩을 만든 사람은 천재라고 생각해요." ]
              }
            ],
            "IV_afterCooking": ["감사합니다. 맛있게 잘 먹을게요!", "잘 먹겠습니다. 수고하세요."],
            "IV_afterCooking70Percent": ["좀 이상한 것 같긴 한데... 일단 잘 먹겠습니다!", "뭔가 이상한 것 같은데? 잘 먹을게요."],
            "IV_afterCooking50Percent": [ "시간이 없어서 뭐라 하지는 못하겠고요... 그냥 먹을게요.", "이렇게 주시면 어떡해요? 다음에는 제대로 주세요..." ],
            "V_emptySubmission": ["이렇게 장사하지 마세요.", "이렇게 하면 돈이 되세요?"]
          }
        },
        {
          "id": "normal_menu_02",
          "name": "eggmayo_wrap",
          "recipe": {
            "ingredients": [
              {"materialId": "tortilla", "quantity": 1},
              {"materialId": "tomato", "quantity": 1},
              {"materialId": "egg_mayo", "quantity": 1}
            ]
          },
          "dialogueTree": {
            "id": "normal_dialogue_02",
            "I_entry": ["안녕하세요. 에그마요 토마토 랩 하나 주세요.", "에그마요 토마토 하나요."],
            "II_additional": ["저는 이상하게 양상추가 싫더라구요.", "에그마요는 언제나 옳은 선택이죠!"],
            "III_hoverHints": [
              {
                "materialId": "tortilla",
                "nearby": [ "또띠아 참 맛있지 않아요? 정신 없이 먹다가 살이 5kg나 쪘어요.", "베이직하니 가볍게 먹기 참 좋죠." ],
                "exact": [ "랩을 만든 사람은 천재라고 생각해요." ]
              },
              {
                "materialId": "tomato",
                "nearby": [ "토마토는 누가 이름을 지었을까요? 어감이 귀엽지 않아요?", "동그랗고 신선하네요." ],
                "exact": [ "토마토는 커도 작아도 맛있죠." ]
              },
              {
                "materialId": "egg_mayo",
                "nearby": [ "저는 계란이 너무 좋아서 한 판씩 먹고 싶다고 생각한 적도 있어요.", "마요네즈와 계란의 조합은 누가 생각한 걸까요?", "노란빛이 도는게 정말 예뻐요." ],
                "exact": [ "부드러우면서 꾸덕한게 최고에요." ]
              }
            ],
            "IV_afterCooking": ["오늘도 역시 황금비율이네요. 맛있어요.", "토마토랑 계란은 역시 최고!"],
            "IV_afterCooking70Percent": ["이상하네. 맛이 원래 이랬나?", "일단 잘 먹을게요. 맛있긴 하네."],
            "IV_afterCooking50Percent": ["맛이 왜이래요 이거?", "토마토랑 계란이 맛없기 쉽지 않은데..."],
            "V_emptySubmission": [ "이렇게 장사하지 마세요.", "이렇게 하면 돈이 되세요?" ]
          }
        },
        {
          "id": "normal_menu_03",
          "name": "kimbop",
          "recipe": {
            "ingredients": [
